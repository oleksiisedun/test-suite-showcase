URL=www.saucedemo.com
USERS_PASSWORD=

# Optional: overrides Playwright's local worker count (e.g. WORKERS=4). Unset uses
# Playwright's own auto-detected default; ignored on CI, which is hardcoded to 1.
WORKERS=

# Optional: overrides local retry count (e.g. RETRIES=2). Unset defaults to 0;
# ignored on CI, which is hardcoded to 2.
RETRIES=

# Set automatically by CI providers (e.g. GitHub Actions sets CI=true) — don't set
# this locally. When set, forbids test.only, hardcodes retries to 2, and workers to 1.
CI=
